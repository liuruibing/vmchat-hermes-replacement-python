{
  "name": "zcjx",
  "version": "1.0.0",
  "description": "A magical vue admin. Typical templates for enterprise applications. Newest development stack of vue. Lots of awesome features",
  "author": "Datadriver",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env BABEL_ENV=development webpack-dev-server --disableHostCheck=true --inline --progress --config build/webpack.dev.conf.js",
    "build:fat": "cross-env NODE_ENV=production env_config=fat node build/build.js",
    "build:prod": "cross-env NODE_ENV=production env_config=prod node build/build.js",
    "build:sit": "cross-env NODE_ENV=production env_config=sit node build/build.js",
    "lint": "eslint --ext .js,.vue src",
    "lint:vmchat": "eslint --ext .js,.vue src/views/vmChat src/api/hermesResearch.js",
    "test": "npm run lint:vmchat && npm run test:vmchat",
    "test:vmchat": "node tests/run-vm-chat-tests.mjs",
    "test:database-knowledge": "node tests/check-database-knowledge.mjs",
    "test:vmchat:live": "cross-env VM_CHAT_LIVE_E2E=1 node tests/vm-chat-live-e2e.test.mjs",
    "test:vmchat:browser": "bash scripts/test-vm-chat-browser-e2e.sh",
    "test:vmchat:browser:live": "cross-env VM_CHAT_BROWSER_LIVE=1 bash scripts/test-vm-chat-browser-e2e.sh",
    "test:vmchat:all": "npm test && npm run test:vmchat:browser",
    "sync:vmchat-contracts": "node scripts/sync-vm-chat-contracts.mjs",
    "precommit": "lint-staged",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix",
      "git add"
    ]
  },
  "keywords": [
    "vue",
    "element-ui",
    "admin",
    "management-system",
    "admin-template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PanJiaChen/vue-element-admin.git"
  },
  "bugs": {
    "url": "https://github.com/PanJiaChen/vue-element-admin/issues"
  },
